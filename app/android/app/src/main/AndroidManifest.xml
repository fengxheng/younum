<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        每月整理提醒要发通知（指南 8.2）。Android 13 起需要运行时申请，
        因此只在用户主动打开提醒开关时才请求（见 ReminderWorker 的说明）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        旧系统（Android 9 及以下）写相册需要它；Android 10 起用 MediaStore
        写 Pictures 目录，不再需要任何存储权限，所以用 maxSdkVersion 限住，
        不让新系统上冒出一个多余的敏感权限（指南 8.3）。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
        在线升级（新版本从 GitHub Release 获取）。

        ⚠️ 这是全应用**唯一**需要联网的地方，而且只用两件事：
        查最新版本号（一个公开的 JSON）、下载安装包。
        账单数据、设备标识、使用记录一概不发送 —— 隐私页与
        docs/RELEASE.md 的文案都是按这个写的，改之前先读它们。

        REQUEST_INSTALL_PACKAGES 只是「允许有数把安装包交给系统安装器」，
        最终装与不装仍由用户在系统界面上点。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        allowBackup=false：实现指南 8.3 要求「仅本地」承诺与系统备份行为一致。
        首版不给用户可用的加密备份格式，因此不让账单被系统云备份静默上传。
    -->
    <application
        android:label="有数"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                「分享账单到有数」：其他应用（微信、文件管理器、网盘…）把一份
                CSV / XLS / XLSX 发给有数时，系统按 MIME 找到这个过滤器。

                ⚠️ 为什么带上 application/octet-stream：很多发送方只知道文件名、
                报不出类型（微信分享文件就是这样），不带这一条的话用户在最常见
                的那条路径上**看不到有数**。代价是有数会出现在更多分享列表里，
                所以内容真伪由 Dart 侧按**内容**判断，不是靠 MIME ——
                不是账单就如实说「这看起来不是账单」，绝不硬导。
                图片、PDF、文本（text/plain）**没有**声明，不会被误拦。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="application/csv"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!--
                文件管理器里「用有数打开」：ACTION_VIEW + content://（Android 7
                起分享方几乎只会给 content:// 了）。scheme 与 mimeType 在每个
                <data> 里成对写清楚，避免属性组合出别的含义。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="text/csv"/>
                <data android:scheme="content" android:mimeType="text/comma-separated-values"/>
                <data android:scheme="content" android:mimeType="application/csv"/>
                <data android:scheme="content" android:mimeType="application/vnd.ms-excel"/>
                <data android:scheme="content" android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:scheme="content" android:mimeType="application/octet-stream"/>
                <data android:scheme="file" android:mimeType="text/csv"/>
                <data android:scheme="file" android:mimeType="text/comma-separated-values"/>
                <data android:scheme="file" android:mimeType="application/vnd.ms-excel"/>
                <data android:scheme="file" android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
            把下载好的安装包交给系统安装器时，不能用 file:// 路径（Android 7 起
            会抛 FileUriExposedException），所以走 FileProvider 给出 content:// URI，
            并只授予读权限。可见范围限定在缓存目录下的 updates/。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!--
            API 30 起的包可见性限制：不声明这一条的话，
            resolveActivity(ACTION_OPEN_DOCUMENT) 会返回 null，
            明明系统里有文件选择器，界面却会把「选择文件」判为不可用。
            声明它只是为了能查询，没有申请任何文件访问权限。
        -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <category android:name="android.intent.category.OPENABLE"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!--
            同上的包可见性：查不到系统安装器的话，升级会被误判为
            「这台设备上没有能安装应用的界面」。
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="content"
                android:mimeType="application/vnd.android.package-archive"/>
        </intent>
    </queries>
</manifest>
